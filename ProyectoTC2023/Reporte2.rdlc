<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
	<DataSource Name="DataSetProveedor">
	  <ConnectionProperties>
		<DataProvider>System.Data.DataSet</DataProvider>
		<ConnectString>/* Local Connection */</ConnectString>
	  </ConnectionProperties>
	  <rd:DataSourceID>4c2b68a8-fd72-4fd5-a5a7-8f4ecbf31b44</rd:DataSourceID>
	</DataSource>
  </DataSources>
  <DataSets>
	<DataSet Name="DataSetProveedorCompras">
	  <Query>
		<DataSourceName>DataSetProveedor</DataSourceName>
		<CommandText>/* Local Query */</CommandText>
	  </Query>
	  <Fields>
		<Field Name="CUIT"><DataField>CUIT</DataField><rd:TypeName>System.String</rd:TypeName></Field>
		<Field Name="NombreProveedor"><DataField>NombreProveedor</DataField><rd:TypeName>System.String</rd:TypeName></Field>
		<Field Name="CantidadCompras"><DataField>CantidadCompras</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
		<Field Name="TotalComprado"><DataField>TotalComprado</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
	  </Fields>
	</DataSet>
  </DataSets>
  <ReportSections>
	<ReportSection>
	  <Body>
		<ReportItems>
		  <Textbox Name="ReportTitle">
			<CanGrow>true</CanGrow>
			<Paragraphs>
			  <Paragraph>
				<TextRuns>
				  <TextRun>
					<Value>Proveedores con más compras</Value>
					<Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight></Style>
				  </TextRun>
				</TextRuns>
				<Style><TextAlign>Center</TextAlign></Style>
			  </Paragraph>
			</Paragraphs>
			<Top>0in</Top><Left>0in</Left><Height>0.35in</Height><Width>7.5in</Width>
		  </Textbox>
		  <Tablix Name="TablixProveedor">
			<TablixBody>
				<TablixColumns>
					<TablixColumn><Width>1.5in</Width></TablixColumn>
					<TablixColumn><Width>2.5in</Width></TablixColumn>
					<TablixColumn><Width>1.5in</Width></TablixColumn>
					<TablixColumn><Width>2in</Width></TablixColumn>
				</TablixColumns>
				<TablixRows>
					<TablixRow>
						<Height>0.35in</Height>
						<TablixCells>
							<TablixCell><CellContents><Textbox Name="HeaderCUIT"><Paragraphs><Paragraph><TextRuns><TextRun><Value>CUIT</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><BackgroundColor>CornflowerBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="HeaderNombre"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Proveedor</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><BackgroundColor>LightSteelBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="HeaderCantidad"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cantidad compras</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><BackgroundColor>CornflowerBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="HeaderTotal"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total comprado</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><BackgroundColor>LightSteelBlue</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
						</TablixCells>
					</TablixRow>
					<TablixRow>
						<Height>0.35in</Height>
						<TablixCells>
							<TablixCell><CellContents><Textbox Name="DataCUIT"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CUIT.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="DataNombre"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!NombreProveedor.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="DataCantidad"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CantidadCompras.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
							<TablixCell><CellContents><Textbox Name="DataTotal"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TotalComprado.Value</Value></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><Format>"$"#,0.00</Format><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
						</TablixCells>
					</TablixRow>
				</TablixRows>
			</TablixBody>
			<TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
			<TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="ProveedorDetails" /></TablixMember></TablixMembers></TablixRowHierarchy>
			<DataSetName>DataSetProveedorCompras</DataSetName>
			<Top>0.45in</Top><Left>0in</Left><Height>0.7in</Height><Width>7.5in</Width>
		  </Tablix>
		</ReportItems>
		<Height>1.5in</Height>
	  </Body>
	  <Width>7.5in</Width>
	  <Page><PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth><LeftMargin>0.5in</LeftMargin><RightMargin>0.5in</RightMargin><TopMargin>0.5in</TopMargin><BottomMargin>0.5in</BottomMargin></Page>
	</ReportSection>
